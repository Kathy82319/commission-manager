{
  "name": "commission-manager",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && npm run build:worker",
    "build:worker": "npx esbuild worker/index.ts --bundle --format=esm --outfile=dist/_worker.js --external:node:*",
    "preview": "vite preview",
    "deploy:test": "copy /Y wrangler.test.jsonc wrangler.jsonc && npm run build && wrangler pages deploy dist --project-name cath-commission-manager --branch main",
    "deploy:prod": "copy /Y wrangler.prod.jsonc wrangler.jsonc && npm run build && wrangler pages deploy dist --project-name commission-app --branch main",
    "deploy:test:linux": "cp wrangler.test.jsonc wrangler.jsonc && npm run build && wrangler pages deploy dist --project-name cath-commission-manager --branch main",
    "deploy:prod:linux": "cp wrangler.prod.jsonc wrangler.jsonc && npm run build && wrangler pages deploy dist --project-name commission-app --branch main"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1030.0",
    "@aws-sdk/s3-presigned-post": "^3.1030.0",
    "@aws-sdk/s3-request-presigner": "^3.1030.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@icons-pack/react-simple-icons": "^13.13.0",
    "@types/dompurify": "^3.0.5",
    "dompurify": "^3.3.3",
    "install": "^0.13.0",
    "lucide-react": "^1.8.0",
    "moment": "^2.30.1",
    "npm": "^11.14.1",
    "react": "^19.2.0",
    "react-big-calendar": "^1.19.4",
    "react-dom": "^19.2.0",
    "react-easy-crop": "^5.5.7",
    "react-helmet-async": "^3.0.0",
    "react-quill-new": "^3.8.3",
    "react-router-dom": "^7.14.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.31.1",
    "@cloudflare/workers-types": "^4.20260417.1",
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.7",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.0.0-beta.13",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^4.81.0"
  },
  "overrides": {
    "vite": "^8.0.0-beta.13"
  }
}
